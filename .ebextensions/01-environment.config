# Non-secret settings only. Secrets (GROQ_API_KEY) are passed with "eb create --envvars".
option_settings:
  aws:elasticbeanstalk:application:environment:
    ENVIRONMENT: production
    LOG_LEVEL: INFO
    GROQ_MODEL: openai/gpt-oss-120b
    AI_TIMEOUT_SECONDS: "30"
    WEB_CONCURRENCY: "2"
    MAX_LOG_CHARS: "50000"
    MAX_UPLOAD_BYTES: "1048576"
    MAX_REQUEST_BYTES: "2097152"
    RATE_LIMIT: "10/minute"
    UPLOAD_RATE_LIMIT: "30/minute"
    # One proxy (EB's nginx) sits in front of the app. Use "2" behind a load balancer.
    TRUSTED_PROXY_HOPS: "1"

  aws:elasticbeanstalk:environment:process:default:
    # Only polled when a load balancer is attached (single-instance mode has none)
    HealthCheckPath: /health

  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: true
    RetentionInDays: 7

  aws:elasticbeanstalk:cloudwatch:logs:health:
    HealthStreamingEnabled: true
    DeleteOnTerminate: true
    RetentionInDays: 7
