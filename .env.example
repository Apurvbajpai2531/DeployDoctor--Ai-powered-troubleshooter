# =====================================================
# DeployDoctor environment variables
# Copy to .env for local use:  cp .env.example .env
# NEVER commit .env
#
# FORMAT RULE: comments go on their own line, never after a value.
# "docker run --env-file" does not strip trailing comments.
# =====================================================

# ---------- Common ----------
# development | production
ENVIRONMENT=development
# DEBUG in development, INFO in production
LOG_LEVEL=DEBUG

# ---------- Groq AI ----------
# Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=30

# ---------- Database (DEVELOPMENT) ----------
# Used by docker compose to create the local Postgres container
POSTGRES_USER=deploy
POSTGRES_PASSWORD=deploy
POSTGRES_DB=deploydoctor
# Running the backend directly on the host: Postgres is published on localhost:5433.
# docker-compose.yml overrides this to host "db", port 5432 for the containerized app.
DATABASE_URL=postgresql://deploy:deploy@localhost:5433/deploydoctor

# ---------- Database (PRODUCTION on Elastic Beanstalk) ----------
# Do NOT set these yourself. Elastic Beanstalk injects them when RDS is attached:
#   RDS_HOSTNAME, RDS_PORT, RDS_DB_NAME, RDS_USERNAME, RDS_PASSWORD
# The app builds its database URL from them automatically.

# ---------- Limits and security ----------
# Max characters of log text accepted
MAX_LOG_CHARS=50000
# 1 MB upload cap
MAX_UPLOAD_BYTES=1048576
# Per client IP, per process
RATE_LIMIT=10/minute
UPLOAD_RATE_LIMIT=30/minute
# Reject request bodies larger than this many bytes (matches nginx client_max_body_size 2M)
MAX_REQUEST_BYTES=2097152
CORS_ORIGINS=http://localhost:8000
# Reverse proxies in front of the app that append to X-Forwarded-For.
# 0 = none (local), 1 = Elastic Beanstalk single instance, 2 = behind a load balancer
TRUSTED_PROXY_HOPS=0

# ---------- Docker Compose ----------
# Host port the app is published on
APP_PORT=8000
APP_PORT=8000
