# =====================================================
# DeployDoctor environment variables
# Copy to .env for local use:  cp .env.example .env
# NEVER commit .env
# =====================================================

# ---------- Common ----------
ENVIRONMENT=development          # development | production
LOG_LEVEL=DEBUG                  # DEBUG in dev, INFO in prod

# ---------- Groq AI ----------
GROQ_API_KEY=                    # get one at https://console.groq.com
GROQ_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=30

# ---------- Database (DEVELOPMENT) ----------
# Used by docker-compose to create the local Postgres container
POSTGRES_USER=deploy
POSTGRES_PASSWORD=deploy
POSTGRES_DB=deploydoctor
# Running the backend directly in WSL: host is localhost (below).
# docker-compose.yml overrides this to host "db" for the containerized app.
DATABASE_URL=postgresql://deploy:deploy@localhost:5433/deploydoctor

# ---------- Database (PRODUCTION on Elastic Beanstalk) ----------
# Do NOT set these yourself. Elastic Beanstalk injects them when RDS is attached:
#   RDS_HOSTNAME, RDS_PORT, RDS_DB_NAME, RDS_USERNAME, RDS_PASSWORD
# The app builds DATABASE_URL from them automatically.

# ---------- Limits & security ----------
MAX_LOG_CHARS=50000              # max characters of log text accepted
MAX_UPLOAD_BYTES=1048576         # 1 MB upload cap
RATE_LIMIT=10/minute             # per client, per instance
CORS_ORIGINS=http://localhost:8000
UPLOAD_RATE_LIMIT=30/minute
# Reject request bodies larger than this (bytes). Matches nginx client_max_body_size 2M.
MAX_REQUEST_BYTES=2097152
# Reverse proxies in front of the app that append to X-Forwarded-For.
# 0 = none (local dev), 1 = Elastic Beanstalk single instance, 2 = behind a load balancer.
TRUSTED_PROXY_HOPS=0
UPLOAD_RATE_LIMIT=30/minute
# Reject request bodies larger than this (bytes). Matches nginx client_max_body_size 2M.
MAX_REQUEST_BYTES=2097152
# Reverse proxies in front of the app that append to X-Forwarded-For.
# 0 = none (local dev), 1 = Elastic Beanstalk single instance, 2 = behind a load balancer.
TRUSTED_PROXY_HOPS=0
UPLOAD_RATE_LIMIT=30/minute
# Reject request bodies larger than this (bytes). Matches nginx client_max_body_size 2M.
MAX_REQUEST_BYTES=2097152
# Reverse proxies in front of the app that append to X-Forwarded-For.
# 0 = none (local dev), 1 = Elastic Beanstalk single instance, 2 = behind a load balancer.
TRUSTED_PROXY_HOPS=0
